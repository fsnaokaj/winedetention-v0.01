{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/u/:h",
      "destination": "/api/wd?a=page&h=:h"
    },
    {
      "source": "/:h",
      "destination": "/api/wd?a=page&h=:h"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}