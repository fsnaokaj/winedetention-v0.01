{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/u/:h", "destination": "/" },
    { "source": "/:h", "destination": "/" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" } ] },
    { "source": "/admin", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ]
}
