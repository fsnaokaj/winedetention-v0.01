{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/giveaway",
      "destination": "/index.html"
    },
    {
      "source": "/giveaways",
      "destination": "/index.html"
    },
    {
      "source": "/vip",
      "destination": "/index.html"
    },
    {
      "source": "/quests",
      "destination": "/index.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/gifts",
      "destination": "/index.html"
    },
    {
      "source": "/gifts/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/party",
      "destination": "/index.html"
    },
    {
      "source": "/live",
      "destination": "/index.html"
    },
    {
      "source": "/spin",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/u/:h",
      "destination": "/api/wd?a=page&h=:h"
    },
    {
      "source": "/:h",
      "destination": "/api/wd?a=page&h=:h"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/wd.js": {
      "includeFiles": "api/_lib/fonts/**",
      "memory": 1024
    }
  }
}
